{
  "rewrites": [
    { "source": "/api/search", "destination": "/api/search.js" },
    { "source": "/api/chat",   "destination": "/api/chat.js"   }
  ],
  "functions": {
    "api/search.js": {
      "includeFiles": "public/**",
      "maxDuration": 30
    },
    "api/chat.js": {
      "maxDuration": 30
    }
  }
}
